# MongoDB Atlas connection string (free M0 cluster is fine)
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/withgod

# Long random string — used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Where the React app is served (for CORS and links in emails)
CLIENT_URL=http://localhost:5173

# Public URL of this API (used for report links sent to parents)
API_URL=http://localhost:4000

# Email for sending report cards to parents (optional).
# On Render's FREE plan use Brevo (SMTP ports are blocked there):
BREVO_API_KEY=
MAIL_FROM="WITH GOD Schools <your-address@gmail.com>"

# Or plain SMTP (local / paid hosting). Gmail needs an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# The single admin account (used by: npm run create-admin)
ADMIN_NAME=School Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=